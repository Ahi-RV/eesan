# Server
PORT=3000
APP_BASE_URL=http://localhost:3000

# Locally synced Personal OneDrive folder. Use forward slashes on Windows.
EESAN_ROOT=C:/Users/your-windows-username/OneDrive/Source

# Required for Stage 2 page text extraction. Point this to a Python 3 install with pypdf.
EESAN_PYTHON=C:/path/to/python.exe

# OCR engine for scanned PDF pages and JPG/JPEG SLD or Manhole Cards.
# Example: C:/Program Files/Tesseract-OCR/tesseract.exe
EESAN_TESSERACT=
EESAN_PDFTOPPM=
