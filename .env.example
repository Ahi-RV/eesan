# Server
PORT=3000
APP_BASE_URL=http://localhost:3000

# Locally synced Personal OneDrive folder. Use forward slashes on Windows.
EESAN_ROOT=C:/Users/your-windows-username/OneDrive/EESAN

# Required for Stage 2 page text extraction. Point this to a Python 3 install with pypdf.
EESAN_PYTHON=C:/path/to/python.exe

# Optional OCR fallback. Leave blank until Tesseract OCR and Poppler are installed.
EESAN_TESSERACT=
EESAN_PDFTOPPM=

