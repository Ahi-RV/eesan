# Server
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Microsoft Entra app registration (personal Microsoft accounts)
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT=consumers
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Optional: use a different start folder below the user's OneDrive root.
EESAN_FOLDER=EESAN

